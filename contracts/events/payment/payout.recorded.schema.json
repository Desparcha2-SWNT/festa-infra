{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/payment/payout.recorded.schema.json",
  "title": "payout.recorded",
  "description": "Un admin registró una liquidación (transferencia manual) a un comercio.",
  "x-exchange": "festa.payment",
  "x-routing-key": "payout.recorded",
  "x-producer": "payment-service",
  "x-version": 1,
  "x-consumers": {
    "notification-service": "avisa al comercio",
    "analytics-service": "dinero liquidado vs pendiente"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payoutId",
    "merchantId",
    "organizerId",
    "amountCents",
    "orderCount",
    "periodFrom",
    "periodTo",
    "recordedBy",
    "paidAt"
  ],
  "properties": {
    "payoutId": {
      "type": "string",
      "format": "uuid"
    },
    "merchantId": {
      "type": "string",
      "format": "uuid"
    },
    "organizerId": {
      "type": "string",
      "format": "uuid"
    },
    "amountCents": {
      "type": "integer",
      "minimum": 0
    },
    "orderCount": {
      "type": "integer",
      "minimum": 1
    },
    "periodFrom": {
      "type": "string",
      "format": "date-time"
    },
    "periodTo": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "string",
      "maxLength": 120
    },
    "recordedBy": {
      "type": "string",
      "format": "uuid"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "payoutId": "b8c9d0e1-f2a3-4b4c-9d5e-6f7a8b9c0d1e",
      "merchantId": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "organizerId": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "amountCents": 100000000,
      "orderCount": 20,
      "periodFrom": "2026-11-01T00:00:00Z",
      "periodTo": "2026-11-08T00:00:00Z",
      "reference": "Transferencia Bancolombia 0001",
      "recordedBy": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b",
      "paidAt": "2026-11-09T15:00:00Z"
    }
  ]
}
