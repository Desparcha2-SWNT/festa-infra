{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/payment/order.approved.schema.json",
  "title": "order.approved",
  "description": "Wompi aprobó el pago (webhook con firma verificada).",
  "x-exchange": "festa.payment",
  "x-routing-key": "order.approved",
  "x-producer": "payment-service",
  "x-version": 1,
  "x-consumers": {
    "booking-service": "crea la asistencia y un pase QR por boleta",
    "notification-service": "envía el recibo",
    "analytics-service": "boletos vendidos e ingresos"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "eventId",
    "organizerId",
    "buyerId",
    "quantity",
    "unitPriceCents",
    "subtotalCents",
    "commissionCents",
    "totalCents",
    "currency",
    "paymentMethod",
    "providerTransactionId",
    "approvedAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "organizerId": {
      "type": "string",
      "format": "uuid"
    },
    "merchantId": {
      "type": "string",
      "format": "uuid"
    },
    "buyerId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "unitPriceCents": {
      "type": "integer",
      "minimum": 0
    },
    "subtotalCents": {
      "type": "integer",
      "minimum": 0
    },
    "commissionCents": {
      "type": "integer",
      "minimum": 0,
      "description": "Comisión de Festa (la paga el comprador)"
    },
    "totalCents": {
      "type": "integer",
      "minimum": 0,
      "description": "subtotal + comisión = lo cobrado"
    },
    "currency": {
      "const": "COP"
    },
    "paymentMethod": {
      "type": "string",
      "enum": [
        "CARD",
        "NEQUI",
        "PSE",
        "BANCOLOMBIA_TRANSFER",
        "OTHER"
      ]
    },
    "providerTransactionId": {
      "type": "string",
      "maxLength": 64,
      "description": "id de la transacción en Wompi"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "orderId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "organizerId": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "merchantId": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "buyerId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "quantity": 2,
      "unitPriceCents": 2500000,
      "subtotalCents": 5000000,
      "commissionCents": 400000,
      "totalCents": 5400000,
      "currency": "COP",
      "paymentMethod": "NEQUI",
      "providerTransactionId": "12345-1698765432-12345",
      "approvedAt": "2026-10-30T18:00:00Z"
    }
  ]
}
