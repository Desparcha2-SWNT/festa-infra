{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/payment/order.failed.schema.json",
  "title": "order.failed",
  "description": "Wompi rechazó, anuló o falló el pago. Los cupos retenidos se liberan.",
  "x-exchange": "festa.payment",
  "x-routing-key": "order.failed",
  "x-producer": "payment-service",
  "x-version": 1,
  "x-consumers": {
    "notification-service": "avisa al comprador",
    "analytics-service": "embudo: pagos fallidos"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "eventId",
    "buyerId",
    "status",
    "failedAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "buyerId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "DECLINED",
        "VOIDED",
        "ERROR"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "providerTransactionId": {
      "type": "string",
      "maxLength": 64
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "orderId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "buyerId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "status": "DECLINED",
      "reason": "Fondos insuficientes",
      "providerTransactionId": "12345-1698765432-12345",
      "failedAt": "2026-10-30T18:00:00Z"
    }
  ]
}
