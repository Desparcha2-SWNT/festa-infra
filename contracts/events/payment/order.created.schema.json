{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/payment/order.created.schema.json",
  "title": "order.created",
  "description": "Se creó una orden y se retuvieron los cupos mientras el usuario paga en Wompi.",
  "x-exchange": "festa.payment",
  "x-routing-key": "order.created",
  "x-producer": "payment-service",
  "x-version": 1,
  "x-consumers": {
    "analytics-service": "embudo: intentos de compra"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orderId",
    "eventId",
    "buyerId",
    "quantity",
    "totalCents",
    "currency",
    "expiresAt",
    "createdAt"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "buyerId": {
      "type": "string",
      "format": "uuid"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "totalCents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "const": "COP"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "orderId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "buyerId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "quantity": 2,
      "totalCents": 5400000,
      "currency": "COP",
      "expiresAt": "2026-10-30T18:15:00Z",
      "createdAt": "2026-10-30T18:00:00Z"
    }
  ]
}
