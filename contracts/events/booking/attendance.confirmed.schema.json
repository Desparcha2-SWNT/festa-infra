{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/booking/attendance.confirmed.schema.json",
  "title": "attendance.confirmed",
  "description": "Asistencia confirmada: RSVP gratis (RF7) o boletas emitidas tras un pago aprobado. Trae el conteo total.",
  "x-exchange": "festa.booking",
  "x-routing-key": "attendance.confirmed",
  "x-producer": "booking-service",
  "x-version": 1,
  "x-consumers": {
    "event-service": "actualiza attendeeCount (y detecta sold out)",
    "notification-service": "confirma al usuario y programa recordatorios",
    "analytics-service": "cuenta asistentes"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attendanceId",
    "eventId",
    "eventTitle",
    "eventStartsAt",
    "userId",
    "source",
    "passIds",
    "attendeeCount",
    "confirmedAt"
  ],
  "properties": {
    "attendanceId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventTitle": {
      "type": "string",
      "maxLength": 120
    },
    "eventStartsAt": {
      "type": "string",
      "format": "date-time"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "rsvp",
        "ticket"
      ]
    },
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "Presente si source = ticket"
    },
    "passIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Un pase QR por asistente/boleta (RNF7)"
    },
    "attendeeCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total de asistentes del evento tras este cambio"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "attendanceId": "d4e5f6a7-b8c9-4d0e-8f1a-2b3c4d5e6f7a",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "eventTitle": "Noche de jazz en La Candelaria",
      "eventStartsAt": "2026-11-07T01:00:00Z",
      "userId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "source": "ticket",
      "orderId": "e5f6a7b8-c9d0-4e1f-8a2b-3c4d5e6f7a8b",
      "passIds": [
        "f6a7b8c9-d0e1-4f2a-8b3c-4d5e6f7a8b9c",
        "a7b8c9d0-e1f2-4a3b-8c4d-5e6f7a8b9c0d"
      ],
      "attendeeCount": 42,
      "confirmedAt": "2026-10-30T18:00:01Z"
    }
  ]
}
