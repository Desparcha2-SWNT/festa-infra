{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/booking/pass.checked_in.schema.json",
  "title": "pass.checked_in",
  "description": "RF10: un QR válido se escaneó en la entrada. Se publica una sola vez por pase (un solo uso).",
  "x-exchange": "festa.booking",
  "x-routing-key": "pass.checked_in",
  "x-producer": "booking-service",
  "x-version": 1,
  "x-consumers": {
    "notification-service": "mensaje de bienvenida al asistente",
    "analytics-service": "cuenta ingresos reales"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passId",
    "attendanceId",
    "eventId",
    "userId",
    "scannedBy",
    "checkedInAt"
  ],
  "properties": {
    "passId": {
      "type": "string",
      "format": "uuid"
    },
    "attendanceId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "scannedBy": {
      "type": "string",
      "format": "uuid"
    },
    "checkedInAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "passId": "f6a7b8c9-d0e1-4f2a-8b3c-4d5e6f7a8b9c",
      "attendanceId": "d4e5f6a7-b8c9-4d0e-8f1a-2b3c4d5e6f7a",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "userId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "scannedBy": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "checkedInAt": "2026-11-07T01:12:00Z"
    }
  ]
}
