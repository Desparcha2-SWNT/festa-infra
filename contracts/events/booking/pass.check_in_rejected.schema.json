{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/booking/pass.check_in_rejected.schema.json",
  "title": "pass.check_in_rejected",
  "description": "Se escaneó un QR que no se aceptó. Sirve para detectar fraude (QR reusado o falso).",
  "x-exchange": "festa.booking",
  "x-routing-key": "pass.check_in_rejected",
  "x-producer": "booking-service",
  "x-version": 1,
  "x-consumers": {
    "analytics-service": "cuenta intentos rechazados por motivo"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "scannedBy",
    "reason",
    "rejectedAt"
  ],
  "properties": {
    "passId": {
      "type": "string",
      "format": "uuid",
      "description": "Ausente si el QR no se pudo leer o la firma es inválida"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "scannedBy": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "already_used",
        "invalid_signature",
        "wrong_event",
        "revoked",
        "outside_window",
        "not_organizer"
      ]
    },
    "firstUsedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Presente si reason = already_used"
    },
    "rejectedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "passId": "f6a7b8c9-d0e1-4f2a-8b3c-4d5e6f7a8b9c",
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "scannedBy": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "reason": "already_used",
      "firstUsedAt": "2026-11-07T01:12:00Z",
      "rejectedAt": "2026-11-07T01:30:00Z"
    }
  ]
}
