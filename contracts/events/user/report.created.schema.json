{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/user/report.created.schema.json",
  "title": "report.created",
  "description": "RF14: alguien reportó un evento o un usuario.",
  "x-exchange": "festa.user",
  "x-routing-key": "report.created",
  "x-producer": "user-service",
  "x-version": 1,
  "x-consumers": {
    "notification-service": "avisa a los admins",
    "analytics-service": "cuenta reportes"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportId",
    "reporterId",
    "targetType",
    "targetId",
    "reason",
    "createdAt"
  ],
  "properties": {
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "reporterId": {
      "type": "string",
      "format": "uuid"
    },
    "targetType": {
      "type": "string",
      "enum": [
        "event",
        "user"
      ]
    },
    "targetId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "fraude",
        "contenido_inapropiado",
        "informacion_falsa",
        "acoso",
        "otro"
      ]
    },
    "comment": {
      "type": "string",
      "maxLength": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "reportId": "c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f",
      "reporterId": "0b9c7d6e-5f4a-4b3c-8d2e-1a0b9c8d7e6f",
      "targetType": "event",
      "targetId": "7a2d3c9f-4b2e-4d4f-8c1b-2a3f4e5d6c7b",
      "reason": "informacion_falsa",
      "comment": "El lugar no existe",
      "createdAt": "2026-10-26T10:00:00Z"
    }
  ]
}
