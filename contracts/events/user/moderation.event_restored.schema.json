{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/user/moderation.event_restored.schema.json",
  "title": "moderation.event_restored",
  "description": "Un admin volvió a mostrar un evento oculto.",
  "x-exchange": "festa.user",
  "x-routing-key": "moderation.event_restored",
  "x-producer": "user-service",
  "x-version": 1,
  "x-consumers": {
    "event-service": "status = published (si no ha expirado)"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "decidedBy": {
      "type": "string",
      "format": "uuid"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "eventId": "7a2d3c9f-4b2e-4d4f-8c1b-2a3f4e5d6c7b",
      "decidedBy": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b",
      "decidedAt": "2026-10-27T12:00:00Z"
    }
  ]
}
