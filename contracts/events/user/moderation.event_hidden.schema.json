{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/user/moderation.event_hidden.schema.json",
  "title": "moderation.event_hidden",
  "description": "Un admin ocultó un evento. event-service lo pasa a hidden y publica event.updated.",
  "x-exchange": "festa.user",
  "x-routing-key": "moderation.event_hidden",
  "x-producer": "user-service",
  "x-version": 1,
  "x-consumers": {
    "event-service": "status = hidden"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "reason",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "decidedBy": {
      "type": "string",
      "format": "uuid"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "eventId": "7a2d3c9f-4b2e-4d4f-8c1b-2a3f4e5d6c7b",
      "reportId": "c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f",
      "reason": "Información falsa",
      "decidedBy": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b",
      "decidedAt": "2026-10-26T12:00:00Z"
    }
  ]
}
