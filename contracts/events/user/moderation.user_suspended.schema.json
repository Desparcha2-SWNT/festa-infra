{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/user/moderation.user_suspended.schema.json",
  "title": "moderation.user_suspended",
  "description": "Un admin suspendió una cuenta.",
  "x-exchange": "festa.user",
  "x-routing-key": "moderation.user_suspended",
  "x-producer": "user-service",
  "x-version": 1,
  "x-consumers": {
    "auth-service": "bloquea login y revoca refresh tokens",
    "event-service": "oculta sus eventos (status hidden)",
    "notification-service": "deja de enviarle push"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "reason",
    "decidedBy",
    "decidedAt"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "reportId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "until": {
      "type": "string",
      "format": "date-time",
      "description": "Ausente = indefinida"
    },
    "decidedBy": {
      "type": "string",
      "format": "uuid"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "userId": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "reportId": "c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f",
      "reason": "Eventos falsos reiterados",
      "decidedBy": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b",
      "decidedAt": "2026-10-26T12:00:00Z"
    }
  ]
}
