{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/user/merchant.verified.schema.json",
  "title": "merchant.verified",
  "description": "Un admin verificó el comercio. Desde ahora puede publicar eventos con boletería.",
  "x-exchange": "festa.user",
  "x-routing-key": "merchant.verified",
  "x-producer": "user-service",
  "x-version": 1,
  "x-consumers": {
    "event-service": "habilita boletería para sus eventos (proyección de comercios verificados)",
    "payment-service": "registra al comercio para liquidaciones",
    "notification-service": "avisa al comercio",
    "analytics-service": "crea el panel del comercio"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "merchantId",
    "userId",
    "businessName",
    "category",
    "place",
    "verifiedBy",
    "verifiedAt"
  ],
  "properties": {
    "merchantId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "businessName": {
      "type": "string",
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "cultural",
        "musical",
        "deportivo",
        "gastronomico"
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "location"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lng"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    "verifiedBy": {
      "type": "string",
      "format": "uuid"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "merchantId": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "userId": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "businessName": "Café Bohemio",
      "category": "gastronomico",
      "place": {
        "name": "Café Bohemio",
        "address": "Cl. 11 #3-45, Bogotá",
        "location": {
          "lat": 4.5981,
          "lng": -74.0758
        }
      },
      "verifiedBy": "9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b",
      "verifiedAt": "2026-10-25T09:00:00Z"
    }
  ]
}
