{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/event/event.expired.schema.json",
  "title": "event.expired",
  "description": "El evento terminó (endsAt pasó) o un Parche en Vivo expiró. Sale del mapa.",
  "x-exchange": "festa.event",
  "x-routing-key": "event.expired",
  "x-producer": "event-service",
  "x-version": 1,
  "x-consumers": {
    "booking-service": "cierra el check-in",
    "payment-service": "cierra la venta y expira órdenes pendientes",
    "ai-service": "lo quita del catálogo",
    "analytics-service": "congela los contadores"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "expiredAt",
    "isLive"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "expiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "isLive": {
      "type": "boolean"
    }
  },
  "examples": [
    {
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "expiredAt": "2026-11-07T04:00:00Z",
      "isLive": false
    }
  ]
}
