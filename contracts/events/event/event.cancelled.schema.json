{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://festa.local/contracts/events/event/event.cancelled.schema.json",
  "title": "event.cancelled",
  "description": "El organizador canceló el evento.",
  "x-exchange": "festa.event",
  "x-routing-key": "event.cancelled",
  "x-producer": "event-service",
  "x-version": 1,
  "x-consumers": {
    "booking-service": "revoca pases y cancela asistencias",
    "payment-service": "deja de vender y pide reembolso de órdenes aprobadas",
    "ai-service": "lo quita del catálogo",
    "notification-service": "avisa a los asistentes",
    "analytics-service": "marca el evento"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "organizerId",
    "title",
    "reason",
    "cancelledAt",
    "version"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "organizerId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "examples": [
    {
      "eventId": "6f1c2b8e-3a1d-4c3e-9b0a-1f2e3d4c5b6a",
      "organizerId": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
      "title": "Noche de jazz en La Candelaria",
      "reason": "Lluvia",
      "cancelledAt": "2026-11-06T20:00:00Z",
      "version": 3
    }
  ]
}
