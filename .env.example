# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.

# ---------- Postgres (una instancia, una BD + un usuario por servicio) ----------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
USER_DB_PASSWORD=change-me-user
EVENT_DB_PASSWORD=change-me-event
BOOKING_DB_PASSWORD=change-me-booking
PAYMENT_DB_PASSWORD=change-me-payment

# ---------- Mongo (una BD + un usuario por servicio) ----------
# Mongo >= 5 exige CPU con AVX. En CPUs sin AVX (p. ej. Pentium/Celeron) usa mongo:4.4.29
MONGO_IMAGE=mongo:7.0
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo
AI_MONGO_PASSWORD=change-me-ai
ANALYTICS_MONGO_PASSWORD=change-me-analytics
NOTIFICATION_MONGO_PASSWORD=change-me-notification

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis

# ---------- RabbitMQ ----------
RABBITMQ_USER=festa
RABBITMQ_PASSWORD=change-me-rabbit

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- JWT (RS256, lo emite auth-service) ----------
# Genera las llaves con:  ./scripts/gen-secrets.sh   (quedan en ./secrets/, ignorado por git)
JWT_ISSUER=festa-auth
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---------- Cifrado de PII en reposo (AES-256-GCM, 32 bytes en base64) ----------
# openssl rand -base64 32
PII_ENCRYPTION_KEY=

# ---------- Login con Google ----------
GOOGLE_CLIENT_IDS=
# Dominio de correo permitido en el piloto (vacío = cualquiera)
ALLOWED_EMAIL_DOMAIN=escuelaing.edu.co
# Primer admin (auth-service lo crea al arrancar si no existe)
ADMIN_EMAIL=admin@escuelaing.edu.co
ADMIN_PASSWORD=change-me-admin1

# ---------- Wompi (sandbox) ----------
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
# Costo de Wompi por transacción (para validar que la comisión lo cubre)
WOMPI_FEE_PERCENT=2.99
WOMPI_FEE_FIXED_CENTS=0
IVA_PERCENT=19
# Comisión de Festa por boleto (debe ser > WOMPI_FEE_PERCENT * (1 + IVA))
COMMISSION_PERCENT=8
COMMISSION_FIXED_CENTS=0
# Minutos que se retiene un cupo mientras el usuario paga
RESERVATION_HOLD_MINUTES=15

# ---------- LLM ----------
# openai | gemini | anthropic | ollama
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-2.5-flash
LLM_DESCRIPTION_MODEL=gemini-2.5-flash
AI_CHAT_RATE_LIMIT_PER_MIN=10

# ---------- Firebase Cloud Messaging ----------
# Ruta (dentro de ./secrets/) al JSON de la cuenta de servicio
FCM_SERVICE_ACCOUNT_FILE=firebase-service-account.json
