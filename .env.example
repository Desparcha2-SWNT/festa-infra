# Copia este archivo a .env y cambia los valores. NUNCA subas .env al repo.

# ---------- Postgres (una instancia, una BD + un usuario por servicio) ----------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
AUTH_DB_PASSWORD=change-me-auth
USER_DB_PASSWORD=change-me-user
EVENT_DB_PASSWORD=change-me-event
BOOKING_DB_PASSWORD=change-me-booking
# Firma el origen de los reintentos de la inbox de payment (HMAC). Una clave por servicio; todas las réplicas de
# payment deben usar la misma. VACÍA a propósito: ./scripts/gen-secrets.sh escribe una aleatoria y persistente en .env.
PAYMENT_INBOX_RETRY_KEY=
PAYMENT_DB_PASSWORD=change-me-payment

# ---------- Mongo (una BD + un usuario por servicio) ----------
# Mongo >= 5 exige CPU con AVX. En CPUs sin AVX (p. ej. Pentium/Celeron) usa mongo:4.4.29
MONGO_IMAGE=mongo:7.0
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-mongo
AI_MONGO_PASSWORD=change-me-ai
ANALYTICS_MONGO_PASSWORD=change-me-analytics
# Firma el origen de los reintentos de la inbox de analytics (HMAC). Una clave por servicio; todas las
# réplicas de analytics deben usar la misma. VACÍA a propósito: ./scripts/gen-secrets.sh escribe una aleatoria
# y persistente en .env (nunca dejes un valor de ejemplo: una clave conocida anula la firma).
ANALYTICS_INBOX_RETRY_KEY=

# Ídem para booking (HMAC del origen de los reintentos de su inbox): vacía a propósito y la genera ./scripts/gen-secrets.sh.
BOOKING_INBOX_RETRY_KEY=

# Ídem para ai (HMAC del origen de los reintentos de su inbox), con la misma regla: vacía a propósito y la
# genera ./scripts/gen-secrets.sh.
AI_INBOX_RETRY_KEY=
NOTIFICATION_MONGO_PASSWORD=change-me-notification

# ---------- Redis ----------
REDIS_PASSWORD=change-me-redis

# ---------- RabbitMQ ----------
RABBITMQ_USER=festa
RABBITMQ_PASSWORD=change-me-rabbit

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- JWT (RS256, lo emite auth-service) ----------
# Genera las llaves con:  ./scripts/gen-secrets.sh   (quedan en ./secrets/, ignorado por git)
JWT_ISSUER=festa-auth
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# ---------- Cifrado de PII en reposo (AES-256-GCM, 32 bytes en base64) ----------
# openssl rand -base64 32
PII_ENCRYPTION_KEY=

# ---------- Login con Google ----------
GOOGLE_CLIENT_IDS=
# Dominio de correo permitido en el piloto (vacío = cualquiera)
ALLOWED_EMAIL_DOMAIN=escuelaing.edu.co
# Primer admin (auth-service lo crea al arrancar si no existe)
ADMIN_EMAIL=admin@escuelaing.edu.co
ADMIN_PASSWORD=change-me-admin1

# ---------- Wompi (sandbox) ----------
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
# Tarifa de Wompi por transacción exitosa (Plan Avanzado: 2,65 % + COP 700 + IVA). La paga el comercio:
# se le descuenta de lo que recibe y el comprador paga solo el precio de la boleta. Festa no cobra comisión
# por boleta (modelo oficial: suscripción Festa Pro). Montos en centavos: COP 700 = 70000.
WOMPI_FEE_PERCENT=2.65
WOMPI_FEE_FIXED_CENTS=70000
IVA_PERCENT=19
# Minutos que se retiene un cupo mientras el usuario paga
RESERVATION_HOLD_MINUTES=15
# Solo desarrollo: permite simular el pago aprobado sin Wompi (POST /api/payments/orders/{id}/simulate)
PAYMENTS_ALLOW_SIMULATION=false
# A dónde vuelve el usuario después de pagar en Wompi (deep link de la app)
WOMPI_REDIRECT_URL=festa://payments/result

# ---------- LLM ----------
# groq | openai | anthropic | ollama. Sin LLM_API_KEY, ai-service usa respuestas locales de ejemplo (sin costo).
# RNF8: modelos de bajo costo, p. ej. openai/gpt-oss-120b (Groq), gpt-4o-mini o claude-haiku-5-5.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_CHAT_MODEL=openai/gpt-oss-120b
LLM_DESCRIPTION_MODEL=openai/gpt-oss-120b
AI_CHAT_RATE_LIMIT_PER_MIN=10

# ---------- Firebase Cloud Messaging ----------
# Ruta (dentro de ./secrets/) al JSON de la cuenta de servicio
FCM_SERVICE_ACCOUNT_FILE=firebase-service-account.json
